# ============================================================================
# xinya · 配置模板
# ----------------------------------------------------------------------------
# 用法：
#   cp system_config.example.env system_config.env
#   chmod 600 system_config.env          # 里面有密钥，必须 600
#   然后把下面标 <必填> 的项填上真实值
#
# 真实值从哪来（迁移期一次性复制，之后各走各的）：
#   /srv/flaskapp/_token.py   ← DB_* / SECRET_KEY / TWILIO_* / CAM_* / Cloudflare DDNS
#   <仓库>/.flaskenv          ← BytePlus / Resend / Cloudflare 邮箱路由 / Google
#   ⚠️ /srv/flaskapp/_token.py 被 6 个项目共用（BearBad devops fahui kellytools
#      sengchong xinya），**只复制值，绝不修改那个文件**。
#
# 加载顺序（后者覆盖前者）：
#   /srv/flaskapp/system_config.shared.env  →  本文件  →  进程环境变量
#
# ⚠️ 改完必须重启（gunicorn / uvicorn）。
#    旧的 env_value() 是每次调用现读 .flaskenv，改 key 免重启；
#    换成 core/config.py 之后是「启动读一次」，改了不重启就是不生效。
#
# ⚠️ 空值等于没填。`KEY=` 会回落到代码里的默认值，不会得到一个空字符串。
#
# ⚠️ **不要在空值那一行写行尾注释。**python-dotenv 对 `KEY=   # 说明` 的解析结果是
#    值等于 "# 说明"（不是空），于是必填项校验会假通过，最后在连库/调 API 时才炸。
#    有值的行写行尾注释没问题，空值的注释一律写在上一行。
# ============================================================================


# ─────────── 身份 / 运行 ───────────
APP_NAME=xinya
APP_ENV=development                      # production | staging | development
APP_DEBUG=false

# 本项目挂在域名的哪个路径下（见 docs/flask_to_fastAPI/11-BASE_PATH.md）。
# 留空 = 挂在根，行为与改造前一致；dev 环境用 /UTBA_DEMO（大写，小写由 nginx 301 过来）。
APP_BASE_PATH=

# 对外绝对地址前缀（二维码、分享链接、OG 图）。留空 = 用当次请求的 Host 推断。
APP_PUBLIC_ORIGIN=https://utbabuddha.com

# <必填> 会话 Cookie 与全部 itsdangerous 签名的根密钥。
# ⚠️⚠️ 改这个 = 全部用户立刻掉线。迁移时必须从 _token.py 逐字节复制，不要重新生成。
SECRET_KEY=


# ─────────── 数据库（PostgreSQL + psycopg3，见 15-PostgreSQL迁移.md）───────────
DB_HOST=127.0.0.1                        # <必填>
DB_PORT=5432

# <必填> ⚠️ 本模板故意不写生产库名 —— 防止有人 cp 完就直连生产。
# dev 必须显式写 UTBA_demo；生产那份 system_config.env 才写生产库名。
# （旧的「dev 自动回落到 demo 库」保护住在仓库 _token.py 里，删掉它之后就没有了。）
DB_NAME=UTBA_demo

# <必填>
DB_USER=
# <必填>
DB_PASSWORD=

# 连接池：PG 默认 max_connections=100，且**每条连接是一个进程**，
# 不像 MySQL 能靠调大参数解决。4 worker × (8+4) = 48 条，余量留给 psql / pg_dump /
# alembic / 其他项目。并发再高的正确做法是上 PgBouncer，不是把这两个数字调大。
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=4
DB_POOL_RECYCLE=280                      # 比对端的空闲断连时间短，主动回收
DB_POOL_PRE_PING=true
DB_ECHO=false                            # 打印 SQL，只在本地排查时开


# ─────────── Redis / 实时（SSE、跨 worker 广播）───────────
REDIS_URL=redis://localhost:6379/0
SOCKET_CHANNEL=xinya_socket
# 等价于原来 app/extensions.py 的白名单 + 「任意 *.utbabuddha.com 子域」判断。
# 子域那段是 `*` 不是 `?`：原函数用 endswith，a.b.utbabuddha.com 也放行。
SOCKET_ALLOWED_ORIGIN_REGEX=^https?://([a-z0-9-]+\.)*utbabuddha\.com(:\d+)?$|^http://(localhost|127\.0\.0\.1):5173$


# ─────────── 路径 ───────────
# 用户上传的文件一律落这里，不能放仓库目录 —— deploy 时 git 会把它们删掉。
DATA_ROOT=/srv/flaskapp/xinya/database
# nginx: location /media_file/ { alias <DATA_ROOT>/; } —— 改这里必须同步改 nginx。
MEDIA_URL_PREFIX=/media_file
# 空值：BASE_PATH（如 /UTBA_DEMO）已经区分了项目，再套一层 /api 不带信息量。
# 整个后端挂在 BASE_PATH 下，形如 https://yukang.utbabuddha.com/UTBA_DEMO/v1/claims
API_PREFIX=
# 仅 Flask 阶段有效（FastAPI 没有等价项）。真正拦住大文件上传的是 nginx 的
# client_max_body_size —— 这个数字不代表「已验证能传 5GB」。
MAX_CONTENT_LENGTH=5242880000


# ─────────── 会话 / 移动端 ───────────
SESSION_LIFETIME_DAYS=7
# 现状是 Flask 默认的 session。11 文档计划改成 xinya_session（多项目共域名时防互相覆盖），
# ⚠️ 改名那一刻所有在线用户掉线一次，挑低峰期做。
SESSION_COOKIE_NAME=session
# SameSite=None + Secure 是为 APK WebView 从 https://localhost 跨域带 Cookie，别改。
SESSION_COOKIE_SAMESITE=None
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
REMEMBER_COOKIE_DAYS=7

MOBILE_ACCESS_TOKEN_SECONDS=1800
MOBILE_REFRESH_TOKEN_DAYS=90
# ⚠️ 改这个 = 所有 APK 需要重新登录。迁移时保持现值 xinya-mobile-session。
MOBILE_ACCESS_TOKEN_SALT=xinya-mobile-session


# ─────────── 签名盐（原本硬编码在代码里，默认值必须一字不差）───────────
# ⚠️ 改任何一个，对应的已发出链接 / 已印出的二维码立刻全部作废。
COUNCIL_SIGN_SALT=council-sign                      # 理事签名链接
EMAIL_CHANGE_SALT=email-change-v1                   # 换邮箱确认链接
CHECK_IN_QR_SALT=xinya-event-check-in-qr-v1         # ⚠️ 已印出的签到二维码


# ─────────── 外部服务：AI（BytePlus / Ark）───────────
# 供读单 OCR、排位 OCR、出题助手、智能分组四处使用。
BYTEPLUS_API_KEY=

# 次选别名：BYTEPLUS_API_KEY 为空时才用它（保留现有代码的取值顺序）。
ARK_API_KEY=

# ★ 必须带 /api/v3。少了这一段，上面四个功能会同时 404。
BYTEPLUS_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
BYTEPLUS_MODEL=seed-2-0-pro-260328

# 留空 = 跟随 BYTEPLUS_MODEL（这是现有代码的优先级：VISION > MODEL > 默认）。
BYTEPLUS_VISION_MODEL=

READ_BILL_DEFAULT_MODEL=auto             # auto | byteplus | local


# ─────────── 外部服务：邮件 ───────────
# 旧名 Resend_API_KEY，大小写两种写法都认（不需要别名表）。
RESEND_API_KEY=

RESEND_BASE_URL=https://api.resend.com
EMAIL_DOMAIN=utba.my                     # 公司邮箱域名 {username}@{EMAIL_DOMAIN}

# 只有仓库根目录的一次性 SMTP 测试脚本 send_mail.py 在用，app/ 不引用。
GMAIL_APP_PASSWORD=


# ─────────── 外部服务：Cloudflare ───────────
# ★ 这里是**两套独立凭据**，已实测 token 与 zone id 的值都不一样，不要合并：
#   EDIT_ZONE_DNS_* : zone 级，给 DDNS 改 A 记录（原 _token.API_TOKEN / ZONE_ID）
#   EMAIL_ROUTING_* : account 级，给邮箱路由（原 .flaskenv 的 *_Cloudflare）
#   后者对 zone 级规则会返回 403 —— 串用的表现是「邮箱能建、转发规则建不了」。
CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4

# ← _token.API_TOKEN
CLOUDFLARE_EDIT_ZONE_DNS_TOKEN=
# ← _token.ZONE_ID（DDNS 用的那个 zone）
CLOUDFLARE_ZONE_ID=
# ← _token.RECORD_NAME
CLOUDFLARE_DNS_RECORD_NAME=

# ← .flaskenv Email_Routing_Address_API_KEY_Cloudflare
CLOUDFLARE_EMAIL_ROUTING_TOKEN=
# ← .flaskenv Zone_ID_Cloudflare（utba.my 的 zone，与上面那个 zone 不是同一个）
CLOUDFLARE_EMAIL_ROUTING_ZONE_ID=
# ← .flaskenv Account_ID_Cloudflare
CLOUDFLARE_ACCOUNT_ID=


# ─────────── 外部服务：Twilio（短信验证码）───────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# ← _token.VERIFY_SERVICE_SID
TWILIO_VERIFY_SERVICE_SID=

# 内部万能验证码（本会人员应急用）。原本硬编码在代码里，挪进配置后按密钥管理。
SHORTCUT_OTP=1031


# ─────────── 外部服务：Google ───────────
GOOGLE_GEOCODING_API_KEY=

# ⚠️ 名字骗人：旧名叫 VITE_GOOGLE_MAPS_EMBED_API_KEY，但它是**后端**读了再经
# API 下发给前端的，不是 Vite 构建变量。所以 gen_frontend_env.sh 不导出它。
GOOGLE_MAPS_EMBED_API_KEY=

GOOGLE_MAPS_BASE_URL=https://maps.googleapis.com


# ─────────── 硬件 ───────────
RECEIPT_PRINTER_IP=192.168.68.43         # 法会收据热敏打印机
RECEIPT_PRINTER_PORT=9100

# 摄像头（ONVIF PTZ）。⚠️ 旧名是 CAM_IP / PORT / USER / PWD —— 后三个与系统环境变量
# 同名（systemd 注入 USER、shell 注入 PWD），照旧名写会被**静默覆盖**，
# 表现是摄像头连不上却不报错。所以一律用 CAM_ 前缀，且不保留旧名。
CAM_IP=
CAM_PORT=80
CAM_USER=
CAM_PASSWORD=


# ─────────── 前端构建（只有这几个键会被导给浏览器）───────────
# scripts/gen_frontend_env.sh 把 APP_BASE_PATH / APP_PUBLIC_ORIGIN 和下面这个键
# 写成 frontend/.env.production。Vite 是**构建期**替换，值会明文进 JS 包，
# 所以这里永远不要放密钥。
#
# ⚠️⚠️ VITE_API_BASE **网页版必须留空**。
# frontend/src/js/apiBase.ts 里 `IS_APK = Boolean(API_BASE)` —— 只要非空，
# 网页版就会被当成 APK 构建（走原生缓存/音乐桥），并且把请求打成跨域绝对地址。
# 空 = 相对路径 = 同源，这就是现在网页版的行为。
# APK 构建不走这里，走 frontend/.env.apk。
VITE_API_BASE=


# ─────────── 开发 ───────────
# ⚠️ 与 frontend/vite.config 的 4 个 dev proxy target（http://localhost:5102）硬绑定，
# 改这里要同步改那边。
DEV_PORT=5102
# 生产监听端口**不在这里** —— 它写死在 systemd unit 的 `gunicorn -b 0.0.0.0:5006` 里。
# 在本文件加 APP_PORT 只会得到一个「写了不生效」的假配置；真要配置化，
# 得同时把 unit 改成 --bind ${APP_HOST}:${APP_PORT}。


# ─────────── 已废弃：不要再填 ───────────
# 下面这些键在代码里已经 0 引用，列出来只是为了说明「不是漏了，是故意不要」：
#   MESSAGING_SERVICE_SID            _token 里有，无人读
#   Edit_Zone_DNS_Cloudflare         .flaskenv 里有，无人读（DDNS 实际走 API_TOKEN）
#   READ_BILL_ADMIN_TOKEN            只存在于 app/account/services.py 的注释里
#   READ_BILL_UPLOAD_URL             旧读单网关，2026-08-28 已下线
#   READ_BILL_PARSE_TEXT_URL         同上
#   FLASK_APP                        Flask CLI 专用，迁 FastAPI 后作废
